# Origin of the SkillDrift API. The guest endpoints live under `{BASE}/api/guest`.
# Development uses the dev tunnel; set this to the real host in staging/production.
NEXT_PUBLIC_API_BASE_URL=https://57bv5zjn-5001.inc1.devtunnels.ms

# reCAPTCHA v3 site key, used to score the guest resume upload. Public by
# design — it ships in the page source, hence the NEXT_PUBLIC_ prefix, which is
# what makes it readable in the browser at all. The matching secret key belongs
# to the API server and must never be added here.
# Leave it unset and uploads still work; the token is simply not sent.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Mixpanel project token. The same project the web app and the API report to,
# so the anonymous funnel joins up across all three. Public by design, hence
# the NEXT_PUBLIC_ prefix. Leave it unset and analytics silently no-ops.
NEXT_PUBLIC_MIXPANEL_TOKEN=
